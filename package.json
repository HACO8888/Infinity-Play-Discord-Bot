{
  "name": "infinity-play-discord-bot",
  "version": "2.0.0",
  "private": true,
  "description": "無限遊玩官方 Discord 機器人",
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "start": "node src/index.ts",
    "deploy-commands": "node src/deploy-commands.ts",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
